# Stage 1: Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

# Dependency manifests
COPY package.json package-lock.json ./

# Install dependencies (including devDependencies for build)
RUN npm install

# Copy full application source
COPY . .

# Build both Vite frontend and verify TypeScript server dependencies
RUN npm run build

# Stage 2: Production Execution Stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy package manifests and install production-only dependencies
COPY package.json package-lock.json ./
RUN npm install --include=dev && npm cache clean --force

# Copy built frontend assets from builder
COPY --from=builder /app/dist ./dist

# Copy server code and required runtime config/modules
COPY --from=builder /app/server ./server
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# Expose Node.js Application Port
EXPOSE 3000

# Healthcheck configuration
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Start Production Node Server
CMD ["npm", "start"]
